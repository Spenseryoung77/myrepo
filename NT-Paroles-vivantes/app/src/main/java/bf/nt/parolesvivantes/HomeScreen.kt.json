package bf.nt.parolesvivantes

import androidx.compose.foundation.Image
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.layout.offset
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Icon
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Brush
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.res.painterResource
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextAlign
import androidx.compose.ui.text.style.TextOverflow
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

@Composable
fun HomeScreen(
    lastBook: String,
    lastChapter: Int,
    day: Verse?,
    random: List<Verse>,
    marks: List<Verse>,
    onMenu: () -> Unit,
    onContinue: () -> Unit,
    onSearch: () -> Unit,
    onMarks: () -> Unit,
    onOpen: (Verse) -> Unit,
    onActions: (Verse) -> Unit,
    onRefresh: () -> Unit,
    onSeeMarks: () -> Unit
) {
    val ink = LocalInk.current
    LazyColumn(
        modifier = Modifier.fillMaxSize().background(ink.bg),
        contentPadding = PaddingValues(bottom = 26.dp)
    ) {
        item("header") {
            Row(
                Modifier.statusBarsPadding().fillMaxWidth().padding(start = 8.dp, end = 14.dp, top = 8.dp, bottom = 4.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                CircleIconButton(R.drawable.ic_menu, "Menu", onMenu, ink.text, 40.dp, iconSize = 20.dp)
                Column(Modifier.padding(start = 4.dp)) {
                    Text("Dernière Lecture", color = ink.sub, fontSize = 11.5.sp, fontFamily = Lora)
                    Text(
                        "$lastBook $lastChapter",
                        color = ink.text,
                        fontSize = 19.sp,
                        fontFamily = Lora,
                        fontWeight = FontWeight.SemiBold
                    )
                }
                Spacer(Modifier.weight(1f))
                Row(
                    Modifier
                        .clip(RoundedCornerShape(50))
                        .background(ink.pill)
                        .height(38.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(Modifier.clickable(onClick = onContinue).padding(horizontal = 16.dp)) {
                        Text("Continuer", color = ink.text, fontSize = 13.sp, fontFamily = Lora)
                    }
                    Box(Modifier.width(1.dp).height(18.dp).background(ink.faint.copy(alpha = .35f)))
                    CircleIconButton(R.drawable.ic_bookmark_line, "Signets", onMarks, ink.text, 36.dp, iconSize = 17.dp)
                    CircleIconButton(R.drawable.ic_search, "Rechercher", onSearch, ink.text, 36.dp, iconSize = 17.dp)
                }
            }
        }
        item("day-title") {
            Row(
                Modifier.fillMaxWidth().padding(start = 20.dp, end = 14.dp, top = 12.dp, bottom = 8.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text("Verset du Jour", color = ink.text, fontSize = 16.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                Spacer(Modifier.weight(1f))
                CircleIconButton(R.drawable.ic_calendar, "Date du verset", { day?.let(onActions) }, ink.text, 36.dp, iconSize = 20.dp)
            }
        }
        if (day != null) {
            item("hero") {
                Column(Modifier.padding(horizontal = 14.dp)) {
                    HeroCard(day, onOpen, onActions)
                }
            }
        }
        item("paroles-title") {
            Row(
                Modifier.fillMaxWidth().padding(start = 22.dp, end = 14.dp, top = 26.dp, bottom = 6.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text("Paroles de Dieu", color = ink.text, fontSize = 16.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                Spacer(Modifier.weight(1f))
                CircleIconButton(R.drawable.ic_refresh, "D'autres versets", onRefresh, ink.sub, 36.dp, iconSize = 19.dp)
            }
        }
        items(random, key = { "r-${it.key}" }) { v ->
            VerseRow(v, onOpen)
        }
        if (marks.isNotEmpty()) {
            item("marks-title") {
                Row(
                    Modifier.fillMaxWidth().padding(start = 22.dp, end = 14.dp, top = 22.dp, bottom = 4.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text("Vos signets", color = ink.text, fontSize = 16.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                    Spacer(Modifier.weight(1f))
                    SeeAllButton(onClick = onSeeMarks)
                }
            }
            items(marks, key = { "m-${it.key}" }) { v -> VerseRow(v, onOpen, marked = true) }
        }
    }
}

@Composable
private fun HeroCard(day: Verse, onOpen: (Verse) -> Unit, onActions: (Verse) -> Unit) {
    val ink = LocalInk.current
    val image = rememberFond(fondFor(day.key))
    val b = Bible.get(localContext())
    Box {
        Column {
            Box(
                Modifier
                    .fillMaxWidth()
                    .height(330.dp)
                    .clip(RoundedCornerShape(topStart = 18.dp, topEnd = 18.dp))
                    .background(ink.card)
                    .clickable { onOpen(day) }
            ) {
                image?.let { Image(it, null, Modifier.fillMaxSize(), contentScale = ContentScale.Crop) }
                Box(
                    Modifier.fillMaxSize().background(
                        Brush.verticalGradient(listOf(Color(0x2E000000), Color(0x59000000), Color(0x66000000)))
                    )
                )
                Box(
                    Modifier
                        .padding(12.dp)
                        .clip(RoundedCornerShape(50))
                        .background(Color(0xFFB9D3A3))
                        .padding(horizontal = 13.dp, vertical = 5.dp)
                ) {
                    Text(frenchDate(), color = Color(0xFF324121), fontSize = 11.5.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                }
                Column(
                    Modifier
                        .align(Alignment.Center)
                        .padding(horizontal = 36.dp)
                        .clip(RoundedCornerShape(10.dp))
                        .background(Color(0x66000000))
                        .padding(horizontal = 18.dp, vertical = 20.dp),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Text(
                        "« ${day.text.trim()} »",
                        color = Color(0xFFF7EFE4),
                        fontFamily = Lora,
                        fontSize = 17.sp,
                        lineHeight = 25.sp,
                        textAlign = TextAlign.Center,
                        maxLines = 7,
                        overflow = TextOverflow.Ellipsis
                    )
                    Spacer(Modifier.height(13.dp))
                    Box(
                        Modifier
                            .clip(RoundedCornerShape(50))
                            .background(Color(0xFFE3C184))
                            .padding(horizontal = 14.dp, vertical = 4.dp)
                    ) {
                        Text(b.ref(day), color = Color(0xFF4A3418), fontSize = 10.5.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                    }
                }
            }
            // Prolongement crème de la photo, comme sur la maquette.
            Column(
                Modifier
                    .fillMaxWidth()
                    .offset(y = (-12).dp)
                    .clip(RoundedCornerShape(bottomStart = 18.dp, bottomEnd = 18.dp))
                    .background(ink.card)
                    .clickable { onOpen(day) }
                    .padding(start = 18.dp, end = 74.dp, top = 20.dp, bottom = 18.dp)
            ) {
                Text(b.ref(day), color = ink.text, fontSize = 17.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
                Spacer(Modifier.height(5.dp))
                Text(
                    day.text,
                    color = ink.text.copy(alpha = .84f),
                    fontSize = 13.5.sp,
                    lineHeight = 20.sp,
                    fontFamily = Lora,
                    maxLines = 3,
                    overflow = TextOverflow.Ellipsis
                )
            }
        }
        Box(
            Modifier
                .align(Alignment.TopEnd)
                .offset(y = 306.dp)
                .padding(end = 14.dp)
                .size(48.dp)
                .clip(CircleShape)
                .background(ink.green)
                .clickable { onActions(day) },
            contentAlignment = Alignment.Center
        ) {
            Icon(painterResource(R.drawable.ic_plus), "Ajouter ce verset", tint = Color(0xFFF3E7D2), modifier = Modifier.size(25.dp))
        }
    }
}

@Composable
private fun VerseRow(v: Verse, onOpen: (Verse) -> Unit, marked: Boolean = false) {
    val ink = LocalInk.current
    val b = Bible.get(localContext())
    val index = b.books.indexOfFirst { it.id == v.book }
    val color = if (marked) {
        val prefs = localContext().ntPrefs()
        val c = prefs.getInt("color.${v.key}", 1).coerceIn(0, 5)
        (if (ink.dark) bookmarksDark else bookmarksLight)[c]
    } else Color.Transparent
    Row(
        Modifier
            .fillMaxWidth()
            .padding(horizontal = 14.dp, vertical = 3.dp)
            .clip(RoundedCornerShape(14.dp))
            .background(color)
            .clickable { onOpen(v) }
            .padding(horizontal = 8.dp, vertical = 11.dp),
        verticalAlignment = Alignment.Top
    ) {
        BookBadge(v.book, index, 38.dp)
        Spacer(Modifier.width(12.dp))
        Column(Modifier.weight(1f)) {
            Text(b.ref(v), color = ink.text, fontSize = 14.5.sp, fontFamily = Lora, fontWeight = FontWeight.SemiBold)
            Spacer(Modifier.height(2.dp))
            Text(
                v.text,
                color = ink.text.copy(alpha = .78f),
                fontSize = 13.5.sp,
                lineHeight = 20.sp,
                fontFamily = Lora,
                maxLines = 3,
                overflow = TextOverflow.Ellipsis
            )
        }
    }
}
