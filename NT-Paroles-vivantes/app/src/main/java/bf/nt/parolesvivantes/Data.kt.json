package bf.nt.parolesvivantes

import android.content.Context
import android.content.SharedPreferences
import android.database.sqlite.SQLiteDatabase
import java.io.File
import java.text.Normalizer

data class Verse(val key: String, val book: String, val chapter: Int, val number: Int, val text: String)
data class Book(val id: String, val name: String, val chapters: Int)

fun normalize(s: String): String =
    Normalizer.normalize(s.lowercase(), Normalizer.Form.NFD).replace(Regex("\\p{M}+"), "")

fun Context.ntPrefs(): SharedPreferences = getSharedPreferences("nt_preferences", Context.MODE_PRIVATE)

/** Accès à la base SQLite embarquée. Toutes les requêtes sont faites hors du fil principal. */
class Bible private constructor(c: Context) {
    private val db: SQLiteDatabase
    val books: List<Book>

    init {
        val file = c.getDatabasePath("nt-v3.db")
        if (!file.exists()) {
            file.parentFile?.mkdirs()
            val temp = File(file.path + ".tmp")
            c.assets.open("nt.db").use { input -> temp.outputStream().use { input.copyTo(it) } }
            check(temp.renameTo(file)) { "Base illisible" }
        }
        db = SQLiteDatabase.openDatabase(file.path, null, SQLiteDatabase.OPEN_READONLY)
        books = db.rawQuery("SELECT id,name,chapters FROM books ORDER BY position", null).use { q ->
            buildList { while (q.moveToNext()) add(Book(q.getString(0), q.getString(1), q.getInt(2))) }
        }
    }

    private fun query(sql: String, args: Array<String>? = null, limit: Int = 4000): List<Verse> =
        db.rawQuery(sql, args).use { q ->
            buildList {
                while (q.moveToNext() && size < limit)
                    add(Verse(q.getString(0), q.getString(1), q.getInt(2), q.getInt(3), q.getString(4)))
            }
        }

    fun chapter(book: String, ch: Int) =
        query("SELECT id,book,chapter,number,text FROM verses WHERE book=? AND chapter=? ORDER BY number",
            arrayOf(book, ch.toString()), 200)

    fun verse(key: String) = query("SELECT id,book,chapter,number,text FROM verses WHERE id=?", arrayOf(key), 1).firstOrNull()

    fun random(exclude: String = "") =
        query("SELECT id,book,chapter,number,text FROM verses WHERE id<>? ORDER BY RANDOM() LIMIT 1",
            arrayOf(exclude), 1).first()

    fun randomList(limit: Int, exclude: Set<String> = emptySet()): List<Verse> {
        val skip = exclude.joinToString(",") { "'" + it.replace("'", "''") + "'" }.ifEmpty { "''" }
        return query("SELECT id,book,chapter,number,text FROM verses WHERE id NOT IN ($skip) ORDER BY RANDOM() LIMIT $limit", null, limit)
    }

    private fun like(text: String): String =
        "%" + normalize(text).replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"

    fun searchTotal(text: String): Int =
        db.rawQuery("SELECT COUNT(*) FROM verses WHERE normalized LIKE ? ESCAPE '\\'", arrayOf(like(text)))
            .use { if (it.moveToFirst()) it.getInt(0) else 0 }

    /** Nombre de résultats par livre, dans l'ordre des livres. */
    fun searchCounts(text: String): List<Pair<String, Int>> =
        db.rawQuery(
            "SELECT v.book, COUNT(*) FROM verses v JOIN books b ON b.id=v.book " +
                "WHERE v.normalized LIKE ? ESCAPE '\\' GROUP BY v.book ORDER BY b.position",
            arrayOf(like(text))
        ).use { q -> buildList { while (q.moveToNext()) add(q.getString(0) to q.getInt(1)) } }

    fun search(text: String, book: String?, offset: Int, limit: Int): List<Verse> {
        val where = "normalized LIKE ? ESCAPE '\\'" + (if (book != null) " AND book=?" else "")
        val args = if (book == null) arrayOf(like(text)) else arrayOf(like(text), book)
        return db.rawQuery(
            "SELECT id,book,chapter,number,text FROM verses WHERE $where ORDER BY rowid LIMIT $limit OFFSET $offset",
            args
        ).use { q -> buildList { while (q.moveToNext()) add(Verse(q.getString(0), q.getString(1), q.getInt(2), q.getInt(3), q.getString(4))) } }
    }

    fun nameOf(id: String) = books.firstOrNull { it.id == id }?.name ?: id
    fun ref(v: Verse) = "${nameOf(v.book)} ${v.chapter} : ${v.number}"
    fun shortRef(v: Verse) = "${nameOf(v.book)} ${v.chapter}"

    companion object {
        @Volatile private var instance: Bible? = null
        fun get(c: Context): Bible = instance ?: synchronized(this) {
            instance ?: Bible(c.applicationContext).also { instance = it }
        }
    }
}

/** Temps de lecture cumulé, en millisecondes. */
fun SharedPreferences.readMillis(book: String, ch: Int): Long = getLong("time.$book.$ch", 0L)
fun SharedPreferences.addReadMillis(book: String, ch: Int, ms: Long) {
    if (ms <= 0 || ms > 6 * 60 * 60 * 1000) return
    edit().putLong("time.$book.$ch", readMillis(book, ch) + ms).apply()
}

/** « 11m », « 45s », « 1h05 ». */
fun formatDuration(ms: Long): String {
    val sec = (ms / 1000).toInt()
    return when {
        sec < 60 -> "${sec.coerceAtLeast(1)}s"
        sec < 3600 -> "${sec / 60}m"
        else -> "${sec / 3600}h" + (sec % 3600 / 60).toString().padStart(2, '0')
    }
}

fun frenchDate(zone: java.time.ZoneId = java.time.ZoneId.systemDefault()): String {
    val d = java.time.LocalDate.now(zone)
    val months = listOf("Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre")
    return "${d.dayOfMonth} ${months[d.monthValue - 1]}"
}

fun relativeDay(timestamp: Long): String {
    if (timestamp <= 0) return ""
    val zone = java.time.ZoneId.systemDefault()
    val day = java.time.Instant.ofEpochMilli(timestamp).atZone(zone).toLocalDate()
    val today = java.time.LocalDate.now(zone)
    val months = listOf("janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc.")
    return when (day) {
        today -> "aujourd'hui"
        today.minusDays(1) -> "hier"
        else -> "${day.dayOfMonth} ${months[day.monthValue - 1]}"
    }
}
